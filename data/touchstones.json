  "tag_vocabulary": {
    "theme": ["uprising", "obedience-psychology", "meta-darmok", "grief-memory", "memes-oneliners", "solidarity"],
    "mood": ["anthemic", "defiant", "clinical-dread", "cathartic", "mythic", "elegiac", "tender", "rowdy", "comic", "triumphant", "wistful", "whimsical"],
    "occasion": ["protest", "vigil", "party", "flash-mob", "demo", "memorial", "rally", "sports-event"]
  },
  "field_notes": {
    "line": "Exact touchstone wording, verbatim from the seed-pool bullet (quoted phrase where the bullet quoted one, else the bullet's descriptor). Never paraphrased.",
    "recognition": "0-100 estimated concept-recognition. null = present in a seed pool but not plucked into a script, so never scored.",
    "degrades": "true if the line still lands literally for people who don't hold the reference (graceful degradation).",
    "shaka_risk": "true if recognition-dependence is high enough that a non-holder gets little/nothing (a 'shaka' miss).",
    "fire_as": "Suggested action type; 'random' = emergent-harmony crowd murmur across phones. null = normal."
  },
